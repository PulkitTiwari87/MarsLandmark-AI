# Data (never commit raw/processed NASA imagery — see docs/DATASET.md)
/data/*
!/data/.gitkeep
/dataset/
*.img
*.IMG
*.fits

# Model artifacts
*.pt
*.pth
*.ckpt
*.h5
*.onnx
/checkpoints/
/models/*.bin

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
__pycache__/

# Notebook checkpoints
.ipynb_checkpoints/

# Environment / secrets
.env
*.env.local
*.pem
*.key

# OS / editor
.DS_Store
.idea/
.vscode/
.claude/

# Logs and reports (generated, not source) — but validation/benchmark
# reports ARE committed as inspectable evidence (project rule: results must
# be reproducible and reviewable without re-running against the full dataset)
*.log
/reports/*.json
!/reports/data_validation.json
!/reports/eda_summary.json
!/reports/split_report.json
!/reports/final_test_evaluation.json
!/reports/final_test_evaluation_run2.json
!/reports/calibration_report.json
!/reports/.gitkeep
/wandb/
/mlruns/
